# API Configuration
# Change to your production API domain
BASE_URL=https://api.yourdomain.com
WS_URL=wss://api.yourdomain.com/ws
CONNECT_TIMEOUT=30000
RECEIVE_TIMEOUT=30000

# Google Sign-In Configuration

# Default Client ID (often used for Web or shared)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_PORT=3001

# Android (Installed App)
# Used when running the app on an Android device/emulator
GOOGLE_CLIENT_ID_ANDROID=your_android_specific_client_id_here

# Desktop (Linux/Windows/macOS) & Web
# Used when running as a desktop app or web app
GOOGLE_CLIENT_ID_DESKTOP=your_web_application_type_client_id_here
GOOGLE_CLIENT_SECRET_DESKTOP=your_web_application_secret_here
