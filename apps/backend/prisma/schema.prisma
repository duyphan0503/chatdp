// Phase 2 — Prisma schema for chatdp

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  phoneNumber  String?  @unique
  email        String?  @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages       Message[]
  participants   Participant[]
  friendshipsOne Friendship[]    @relation("userOne")
  friendshipsTwo Friendship[]    @relation("userTwo")
  MessageStatus  MessageStatus[]
  refreshTokens  RefreshToken[]
  reactions      Reaction[]
  media          Media[]

  @@index([displayName])
}

model Conversation {
  id             String           @id @default(uuid())
  type           ConversationType
  groupName      String?
  groupAvatarUrl String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  participants Participant[]
  messages     Message[]
  media        Media[]
}

enum ConversationType {
  private
  group
}

model Participant {
  userId         String
  conversationId String
  joinedAt       DateTime        @default(now())
  role           ParticipantRole @default(member)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([conversationId])
}

enum ParticipantRole {
  admin
  member
}

model Message {
  id               String      @id @default(uuid())
  conversationId   String
  senderId         String
  contentType      ContentType
  content          String?
  mediaUrl         String?
  createdAt        DateTime    @default(now())
  replyToMessageId String?
  deletedAt        DateTime?

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  statuses     MessageStatus[]
  replyTo      Message?        @relation("MessageReply", fields: [replyToMessageId], references: [id])
  replies      Message[]       @relation("MessageReply")
  reactions    Reaction[]
  media        Media[]
  outboxEvents MessageOutbox[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model MessageOutbox {
  id           String       @id @default(uuid())
  messageId    String
  eventType    String
  payload      Json
  status       OutboxStatus @default(pending)
  attempts     Int          @default(0)
  errorMessage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  processedAt  DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

enum OutboxStatus {
  pending
  processed
  failed
}

enum ContentType {
  text
  image
  video
  file
  voice
}

model MessageStatus {
  messageId String
  userId    String
  status    DeliveryStatus
  readAt    DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

enum DeliveryStatus {
  delivered
  read
}

model Friendship {
  userOneId    String
  userTwoId    String
  status       FriendshipStatus
  actionUserId String

  userOne User @relation("userOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo User @relation("userTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  @@id([userOneId, userTwoId])
  @@index([status])
}

enum FriendshipStatus {
  pending
  accepted
  blocked
}

// Phase 3 — Auth: DB-backed refresh tokens (scaffold)
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([userId])
}

model Media {
  id             String   @id @default(uuid())
  uploaderId     String
  conversationId String?
  messageId      String?
  url            String
  mimeType       String?
  size           Int?
  contentId       String?
  status          String?
  expiresAt       DateTime?
  lastAccessAt    DateTime?
  storageProvider String?
  objectKey       String?
  createdAt      DateTime @default(now())

  uploader     User          @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([uploaderId, createdAt])
  @@index([expiresAt])
  @@index([lastAccessAt])
}
