# Example environment variables for @chatdp/backend
# Phase 1 — Security Baseline + Phase 2 seed vars

# Runtime
NODE_ENV=development
PORT=3000

# CORS allowlist: comma-separated origins or "*" to allow all
# In development, leaving this empty allows all by default
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
# Auth endpoints specific rate limits
RATE_LIMIT_AUTH_TTL=60
RATE_LIMIT_AUTH_LIMIT=5

# WebSocket rate limiting (Phase 5 placeholders)
WS_RATE_LIMIT_TTL=60
WS_RATE_LIMIT_LIMIT=120

# WebSocket call initiation rate limiting (Phase 8)
WS_CALL_RATE_LIMIT_TTL=60
WS_CALL_RATE_LIMIT_LIMIT=30

# Database
# For local Postgres (Docker or managed)
DATABASE_URL=your_database

# --- Local Docker stack helpers (Postgres / MongoDB / Redis / Cloudflare Tunnel) ---
# The variables below are not read directly by the backend.
# They are primarily used for:
# - apps/backend/docker/.env (docker-compose stack)
# - Keeping configuration in sync between backend and docker-compose
#
# Postgres (docker-compose service: "postgres")
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_postgres_db
#
# MongoDB (docker-compose service: "mongodb")
MONGO_INITDB_ROOT_USERNAME=your_mongo_root_username
MONGO_INITDB_ROOT_PASSWORD=your_mongo_root_password
MONGO_INITDB_DATABASE=your_mongo_database
#
# Redis (docker-compose service: "redis")
REDIS_PASSWORD=your_redis_password
#
# Cloudflare Tunnel (docker-compose service: "cloudflared")
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token
#
# When running the backend directly on the host, you can use these values to build:
# - DATABASE_URL
# - MONGODB_URI
# - REDIS_URL
#
# Polyglot read model (MongoDB)
# Optional: leave unset to disable Mongo read model in local/dev
# When disabled or when Mongo cannot be initialized, the backend automatically
# falls back to the Postgres read-path for timelines.
# Example for local Docker (mongo exposed on localhost:27017)
# MONGODB_URI=mongodb://<username>:<password>@localhost:27017/<database>?authSource=admin
# MONGODB_DBNAME=<database>
USE_MONGO_READ_MODEL=false
# Background projector for Mongo read model
# When true and USE_MONGO_READ_MODEL=true and Mongo is configured, a lightweight
# in-process runner will periodically project pending MessageOutbox rows into the
# Mongo read model. In most setups you can keep this enabled.
# MONGO_PROJECTOR_ENABLED=true
# MONGO_PROJECTOR_INTERVAL_MS=1000
# MONGO_PROJECTOR_BATCH_SIZE=100

# Redis (Phase 7 - Hardening, optional)

# When set, enables Redis-backed distributed HTTP rate limiting.
# Example for local Docker (redis exposed on localhost:6379)
# REDIS_URL=redis://default:<password>@localhost:6379


# Media storage (Phase 9 - Media & Groups)
# Driver: "local" (default, fake URLs) or "s3" for S3/MinIO-compatible storage.
# MEDIA_STORAGE_DRIVER=local
#
# S3/MinIO configuration (required when MEDIA_STORAGE_DRIVER=s3)
# MEDIA_S3_BUCKET=your-bucket-name
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_ENDPOINT=http://localhost:9000
# MEDIA_S3_ACCESS_KEY=your-access-key
# MEDIA_S3_SECRET_KEY=your-secret-key
#
# Optional public base URL for serving media (e.g. CDN or reverse proxy)
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com
#
# Presigned URL TTL (seconds)
# MEDIA_PRESIGN_EXPIRES_IN=300

# Auth (Phase 3 scaffold)

# Strong secret (>=32 chars). Generate via: pnpm --filter @chatdp/backend gen:jwt-secret
JWT_SECRET=change_me_replace_with_generated_value
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL=7d
# Bind refresh tokens to UA/IP (true|false)
# If granular flags below are not set, this value is used for both UA and IP
REFRESH_BIND_UA_IP=true
# Optional granular toggles (inherit from REFRESH_BIND_UA_IP if unset)
# REFRESH_BIND_UA=true
# REFRESH_BIND_IP=true

# Networking / Proxy
# When behind a reverse proxy/CDN (e.g., Nginx, Cloudflare), set to true to extract client IP from headers
TRUST_PROXY=false

# Logging
# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Optional frontend URL (for CORS or links)
# FRONTEND_URL=https://example.com

# Example API base URL
API_BASE_URL=https://your-api-base-url.example.com
